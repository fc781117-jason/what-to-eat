# Google Places API (New) — server only. Never prefix the key with NEXT_PUBLIC_.
GOOGLE_PLACES_LIVE_ENABLED=false
GOOGLE_PLACES_API_KEY=

# "pro" requests name/address/location/Maps URL/category. "enterprise" also
# requests rating/review count/price level/opening status and has a higher SKU.
GOOGLE_PLACES_FIELD_TIER=pro

# Existing integrations kept for later phases
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_PLACE_PROXY_URL=
